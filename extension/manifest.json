{
  "manifest_version": 3,
  "name": "Invoice to ERP Assistant",
  "version": "1.0.0",
  "description": "Extracts bill/invoice data using lightweight OCR and autofills ERP web forms with human verification.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Invoice ERP Assistant"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/erp.js"],
      "run_at": "document_idle"
    }
  ]
}
